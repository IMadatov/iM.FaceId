# CUDA 12.6 cuDNN runtime base for ONNX Runtime GPU wheels.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app

COPY requirements-gpu.txt .
RUN pip install --no-cache-dir -r requirements-gpu.txt

ENV MODEL_DIR=/app/models \
    LIVENESS_MODEL_PATH=/app/models/liveness/minifasnet_v2.onnx \
    FACE_DEVICE=auto \
    PYTHONUNBUFFERED=1

COPY scripts/download_models.py scripts/download_liveness_model.py ./scripts/
RUN python scripts/download_models.py \
    && python scripts/download_liveness_model.py

COPY app ./app
COPY scripts ./scripts

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
