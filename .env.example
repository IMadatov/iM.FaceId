# Copy to .env and adjust. `$` in passwords must be URL-encoded as %24.
# Compose (API container → host Postgres):
DATABASE_URL=postgresql+psycopg://imfaceid:CHANGE_ME%24@host.docker.internal:5432/imfaceid
# Host uvicorn (no Docker for API):
# DATABASE_URL=postgresql+psycopg://imfaceid:CHANGE_ME%24@localhost:5432/imfaceid

# Face quality defaults (liveness=true). Clients may override via JSON request body.
# Relax to disable a check (blur 0; brightness 0/255; min side 0).
# FACE_BLUR_MIN_VARIANCE=50
# FACE_BRIGHTNESS_MIN=40
# FACE_BRIGHTNESS_MAX=220
# FACE_MIN_SIDE_PX=80
# LIVENESS_THRESHOLD=0.50
# FACE_MATCH_THRESHOLD=0.40

# Multi-frame liveness (POST /v1/faces/liveness). See docs/LIVENESS_API.md;
# both planarity values are starting points, not calibrated on real captures.
# LIVENESS_MIN_DISTANCE=0.05
# Nose motion-parallax threshold; 0 disables the planarity check entirely.
# LIVENESS_MIN_PLANARITY=0.06
# Head turn required before parallax is judged (~13 degrees of yaw, at any
# camera distance).
# LIVENESS_MIN_VIEW_CHANGE=0.025

# Face inference device: auto (CUDA if available else CPU), cpu, or cuda
FACE_DEVICE=auto
